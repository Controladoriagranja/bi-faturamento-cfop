# Copiar para .env.local (ignorado pelo Git), sem publicar credenciais.
# Alternativa de leitura: preencher os PG* abaixo, sem definir FOB_PG_READ_DSN.
PGHOST=
PGPORT=
PGDATABASE=bi_granja
PGUSER=
PGPASSWORD=
FOB_PLANILHAS_DIR=\\192.168.1.139\Controladoria\BI_Granja\Planilhas_Faturamento_Cfop
# Opcional: DSN de leitura completa; não preencher com valores fictícios.
FOB_PG_READ_DSN=
# Escrita futura: DSN da conta técnica, separada da configuração de leitura.
FOB_PG_WRITE_DSN=
# Backups privados da prévia: padrão %LOCALAPPDATA%\GranjaBrasilia\FOB.
# Não apontar para assets/, docs/ ou outra pasta publicada.
FOB_ESTADO_DIR=
# ID numérico técnico reservado pelo administrador, exclusivamente para auditoria
# da tabela mensal legada. Não é login CENTRAL nem autoriza acesso ao Portal.
FOB_ROBOT_ACTOR_ID=
# Na configuração SEPARADA da API: FOB_MASTER_ENABLED=0 até homologação.
