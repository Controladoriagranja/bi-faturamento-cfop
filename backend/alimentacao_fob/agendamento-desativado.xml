<?xml version="1.0"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>FOB: proposta DESATIVADA para MDE-100154/vchaves. Sincronizar os três mestres a cada 15 minutos, 07h–19h, somente com sessão Windows aberta. Não registra tarefa por si só. Habilitar apenas após autorização; o pós-faturamento usa separadamente o mesmo BAT com --faturamento-ok.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <Repetition><Interval>PT15M</Interval><Duration>PT12H</Duration><StopAtDurationEnd>false</StopAtDurationEnd></Repetition>
      <StartBoundary>2026-10-26T07:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Robot">
      <UserId>MDE-100154\vchaves</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <Enabled>false</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Robot">
    <Exec>
      <Command>C:\Windows\System32\cmd.exe</Command>
      <Arguments>/d /c ""C:\Users\vchaves\Documents\GitHub\bi-faturamento-cfop\backend\alimentacao_fob\atualizar_fob.bat" --sincronizar"</Arguments>
      <WorkingDirectory>C:\Users\vchaves\Documents\GitHub\bi-faturamento-cfop\backend</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
